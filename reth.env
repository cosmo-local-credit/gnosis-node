# Reth execution-layer config.
# Edit this file and run: docker compose up -d
# Chiado values are commented out.

# gnosis (chain id 100) | chiado (chain id 10200)
RETH_CHAIN=gnosis
# RETH_CHAIN=chiado

# full | minimal | archive
# full = recent state + full bodies (default for this project)
RETH_NODE_TYPE=full

RETH_DATADIR=/data
# Overrides merged over reth's built-in defaults. See reth.toml for why the
# execution thresholds are lowered. Leave empty to use upstream defaults.
RETH_CONFIG=/config/reth.toml
RETH_AUTHRPC_JWTSECRET=/shared/jwt.hex
RETH_AUTHRPC_ADDR=0.0.0.0
RETH_AUTHRPC_PORT=8551

RETH_HTTP=true
RETH_HTTP_ADDR=0.0.0.0
RETH_HTTP_PORT=8545
RETH_HTTP_API=net,eth,web3,txpool
RETH_HTTP_CORSDOMAIN=*

RETH_WS=true
RETH_WS_ADDR=0.0.0.0
RETH_WS_PORT=8546
RETH_WS_API=net,eth,web3,txpool
RETH_WS_ORIGINS=*

RETH_PORT=30303
RETH_DISCOVERY_PORT=30303
RETH_DISCOVERY_ADDR=0.0.0.0
RETH_NAT=any

RETH_METRICS=true
RETH_METRICS_ADDR=0.0.0.0
RETH_METRICS_PORT=9001

# Space-separated extra flags appended to `reth node`
RETH_EXTRA_ARGS=

# Snapshot restore (used by ./bootstrap.sh, not by the running node)
# Official snapshots: https://reth-snapshots.gnosischain.com
RETH_SNAPSHOT=true
RETH_SNAPSHOT_MANIFEST_URL=https://reth-snapshots.gnosischain.com/latest/gnosis/manifest.json
# RETH_SNAPSHOT_MANIFEST_URL=https://reth-snapshots.gnosischain.com/latest/chiado/manifest.json
