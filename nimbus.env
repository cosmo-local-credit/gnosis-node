# Nimbus consensus-layer config (beacon node only, no validator).
# Edit this file and run: docker compose up -d
# Chiado values are commented out.

NIMBUS_NETWORK=gnosis
# NIMBUS_NETWORK=chiado

NIMBUS_DATADIR=/data
NIMBUS_EL=http://reth:8551
NIMBUS_JWTSECRET=/shared/jwt.hex

# prune = full node (no historical CL states). archive keeps them.
NIMBUS_HISTORY=prune

NIMBUS_TCP_PORT=9000
NIMBUS_UDP_PORT=9000
NIMBUS_ENR_AUTO_UPDATE=true

NIMBUS_REST=true
NIMBUS_REST_ADDRESS=0.0.0.0
NIMBUS_REST_PORT=5052

NIMBUS_METRICS=true
NIMBUS_METRICS_ADDRESS=0.0.0.0
NIMBUS_METRICS_PORT=8008

NIMBUS_LIGHT_CLIENT=true
# only-new avoids the expensive historic import. Use full only when serving
# historical light-client data is an explicit requirement.
NIMBUS_LIGHT_CLIENT_IMPORT_MODE=only-new
NIMBUS_MAX_PEERS=160

# Space-separated extra flags appended to nimbus_beacon_node
NIMBUS_EXTRA_ARGS=

# Checkpoint / trusted-node sync (used by ./bootstrap.sh)
# Official endpoints from https://docs.gnosischain.com/node
NIMBUS_CHECKPOINT=true
NIMBUS_CHECKPOINT_SYNC_URL=https://checkpoint.gnosischain.com
# NIMBUS_CHECKPOINT_SYNC_URL=https://checkpoint.chiadochain.net
# false = reach head in minutes, then backfill from the p2p network
NIMBUS_CHECKPOINT_BACKFILL=false
